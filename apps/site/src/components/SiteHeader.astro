---
import { SITE_SHELL_COPY } from "./copy";

interface Props {
  activePath: "/" | "/resume/" | "/lab/replay/" | null;
  brandName: string;
}

const { activePath, brandName } = Astro.props;

const links = [
  { href: "/", label: SITE_SHELL_COPY.portfolioLink },
  { href: "/resume/", label: SITE_SHELL_COPY.resumeLink },
  { href: "/lab/replay/", label: SITE_SHELL_COPY.labLink },
] as const;
---

<header class="site-header">
  <div class="site-header__inner content-frame">
    <a class="site-brand" href="/" aria-label={SITE_SHELL_COPY.homeLinkLabel}>
      {brandName}
    </a>
    <nav class="site-nav" aria-label={SITE_SHELL_COPY.primaryNavigationLabel}>
      <ul>
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={link.href === activePath ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
