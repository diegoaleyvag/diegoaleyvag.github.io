---
import BaseLayout from "../layouts/BaseLayout.astro";
import { NOT_FOUND_COPY, primaryNav } from "../lib/i18n";

import "../styles/sections.css";

const en = NOT_FOUND_COPY.en;
const es = NOT_FOUND_COPY.es;
const enLinks = primaryNav("en");
const esLinks = primaryNav("es");
---

<BaseLayout
  lang="en"
  title={en.documentTitle}
  description={en.body}
  path="/404.html"
  alternatePath={null}
  activeHref={null}
>
  <div class="content-frame not-found">
    <p class="not-found__code" aria-hidden="true">404</p>
    <h1>{en.heading}</h1>
    <p>{en.body}</p>
    <ul class="not-found__links">
      {
        enLinks.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))
      }
    </ul>

    <hr />

    <h2 lang="es">{es.heading}</h2>
    <p lang="es">{es.body}</p>
    <ul class="not-found__links" lang="es">
      {
        esLinks.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .not-found {
    padding-block: 2.5rem 6rem;
  }

  .not-found__code {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(6rem, 22vw, 14rem);
    line-height: 0.85;
    color: var(--signal-ink);
  }

  .not-found h1 {
    margin-block-start: 0;
    padding-block-start: 1.5rem;
  }

  .not-found hr {
    margin-block: 2.5rem;
  }

  .not-found__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
  }

  .not-found__links a {
    display: inline-block;
    color: var(--graphite);
    font-weight: 800;
    text-decoration: none;
    border: var(--rule-width) solid var(--graphite);
    border-radius: var(--radius);
    padding: 0.65rem 1.15rem;
  }

  .not-found__links a:hover {
    background: var(--graphite);
    color: var(--field);
  }
</style>
