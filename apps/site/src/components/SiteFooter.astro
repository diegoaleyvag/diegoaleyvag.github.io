---
import { SHELL_COPY, primaryNav, type Lang } from "../lib/i18n";

interface Props {
  readonly lang: Lang;
}

const { lang } = Astro.props;
const shellCopy = SHELL_COPY[lang];
const links = primaryNav(lang);
---

<footer class="site-footer">
  <div class="site-footer__inner content-frame">
    <p>{shellCopy.footerNote}</p>
    <nav aria-label={shellCopy.footerNavigationLabel}>
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>
