# Copy to .env for local use. Never commit a real .env file.
# SITE_URL is public metadata (used for canonical/OG URLs), never a secret.
# It has a safe fallback in apps/site/astro.config.mjs, so this is optional
# for local builds; set it once the real Vercel project domain is confirmed.
SITE_URL=https://diegoaleyvag.vercel.app

# Ask Diego's optional model provider (AGENTS.md, .cursor/rules/ai-guide.mdc):
# off by default. Only apps/site/src/pages/api/ask.ts reads these, only on
# the server, only through the single createProviderFromEnv composition
# root — never in browser code or a PUBLIC_*-style variable. With either
# left unset, /api/ask runs corpus-only and gracefully degrades to the
# static FAQ; nothing else on the site depends on them.
#
# AI_GUIDE_MODEL: an OpenAI-Chat-Completions-compatible model identifier
# for the configured gateway/endpoint, e.g. "anthropic/claude-haiku".
AI_GUIDE_MODEL=
# AI_GUIDE_API_KEY: the bearer credential for that endpoint. Real value
# lives only in Vercel's server-side environment variables, never here.
AI_GUIDE_API_KEY=
# AI_GUIDE_BASE_URL: optional override of the OpenAI-compatible base URL.
# Defaults to Vercel AI Gateway's REST surface (https://ai-gateway.vercel.sh/v1)
# in code when left unset; only set this to point at a different
# OpenAI-compatible endpoint.
AI_GUIDE_BASE_URL=
