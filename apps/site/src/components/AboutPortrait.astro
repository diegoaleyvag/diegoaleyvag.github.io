---
// A real photograph, provided directly by Diego (owner-supplied, never
// AI-generated — AGENTS.md "No fabricated photography" only ever forbade a
// *generated* portrait; a real one supersedes the placeholder it replaces).
// Self-hosted and build-time optimized via Astro's own image pipeline
// (astro:assets → sharp), emitting AVIF with a WebP fallback and explicit
// width/height so no third-party request or layout shift is introduced.
import { Picture } from "astro:assets";

import portraitSource from "../assets/diego-portrait.jpg";

interface Props {
  readonly altText: string;
}

const { altText } = Astro.props;
const DISPLAY_SIZE = 480;
---

<figure class="about-portrait">
  <Picture
    src={portraitSource}
    alt={altText}
    formats={["avif", "webp"]}
    width={DISPLAY_SIZE}
    height={DISPLAY_SIZE}
    loading="lazy"
    decoding="async"
    class="about-portrait__image"
  />
</figure>

<style>
  .about-portrait {
    margin: 0;
  }

  .about-portrait__image {
    display: block;
    width: min(100%, 14rem);
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--radius);
  }
</style>
